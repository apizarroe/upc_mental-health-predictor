# Variables de entorno para prevenir conflictos OpenMP en macOS
# Esto evita el crash cuando múltiples librerías usan diferentes versiones de OpenMP

# Permitir múltiples librerías OpenMP (soluciona el crash)
export KMP_DUPLICATE_LIB_OK=TRUE

# Configuración de threads para XGBoost y PyTorch
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
