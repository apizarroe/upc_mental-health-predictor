# ============================================
# CONFIGURACIÓN BACKEND PYTHON (ML API) - DESARROLLO LOCAL
# ============================================
# Copia este archivo como .env y ajusta según tu entorno

# ===========================================
# DESARROLLO LOCAL (Recomendado)
# ===========================================

# Configuración del servidor
PORT=8000
HOST=0.0.0.0
RELOAD=true

# Modelo BERT
BERT_MODEL_NAME=bert-base-uncased
# Para desarrollo local, usar ruta relativa desde la raíz del backend
BERT_MODEL_PATH=./data/trained_models/bert_model

# Modelos de ML tradicionales
XGBOOST_MODEL_PATH=./data/trained_models/xgboost_model.pkl
RF_MODEL_PATH=./data/trained_models/rf_model.pkl

# Configuración de procesamiento
MAX_LENGTH=512
BATCH_SIZE=32
NUM_LABELS=3

# Device de procesamiento
# Opciones: cpu (desarrollo), cuda (GPU NVIDIA), mps (GPU Mac M1/M2)
DEVICE=cpu

# Configuración de logging
LOG_LEVEL=DEBUG
LOG_FILE=./logs/ml_api.log

# CORS (permitir requests desde el frontend en desarrollo)
# SvelteKit dev server corre en puerto 5173 por defecto
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Cache de predicciones (desactivado en desarrollo para testing)
ENABLE_CACHE=false
CACHE_TTL=3600

# Límite de rate limiting (más permisivo en desarrollo)
RATE_LIMIT=1000

# ===========================================
# PRODUCCIÓN / DOCKER (Descomenta si usas Docker)
# ===========================================

# Para Docker, descomentar y ajustar:
# PORT=8000
# HOST=0.0.0.0
# RELOAD=false
# LOG_LEVEL=INFO
# ENABLE_CACHE=true
# RATE_LIMIT=100
# CORS_ORIGINS=http://localhost:3000
