# ============================================
# CONFIGURACIÓN FRONTEND SVELTEKIT - DESARROLLO LOCAL
# ============================================
# Copia este archivo como .env y ajusta según tu entorno

# ===========================================
# DESARROLLO LOCAL (Recomendado)
# ===========================================

# URL del microservicio de ML (Backend Python)
# Desarrollo: ambos servicios en localhost
PUBLIC_ML_API_URL=http://localhost:8000

# Base de datos PostgreSQL (local)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/salud_mental_app

# Autenticación
# Genera un secret seguro con: openssl rand -base64 32
# Para desarrollo puedes usar este temporal:
AUTH_SECRET=dev-secret-change-in-production-min-32-characters

# Entorno
NODE_ENV=development

# Configuración de la aplicación
PUBLIC_APP_NAME=Mental Health Predictor
PUBLIC_APP_VERSION=1.0.0

# Puerto del servidor de desarrollo
PORT=5173

# Configuración de logs
LOG_LEVEL=debug

# ===========================================
# PRODUCCIÓN / DOCKER (Descomenta si usas Docker)
# ===========================================

# Para Docker, descomentar estas líneas:
# PUBLIC_ML_API_URL=http://ml-api:8000
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/salud_mental_app
# NODE_ENV=production
# LOG_LEVEL=info
