# ============================================
# CONFIGURACIÓN DOCKER COMPOSE
# ============================================
# Este archivo define las variables de entorno para docker-compose.yml
# Copia este archivo como .env y ajusta los valores según tu entorno

# Frontend Web Service
ML_API_URL=http://ml-api:8000
DATABASE_URL=file:/app/data/app.db
AUTH_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Backend ML API Service
ML_API_PORT=8000
BERT_MODEL_NAME=bert-base-uncased
BERT_MODEL_PATH=/app/data/trained_models/bert_model
XGBOOST_MODEL_PATH=/app/data/trained_models/xgboost_model.pkl
RF_MODEL_PATH=/app/data/trained_models/rf_model.pkl
MAX_LENGTH=512
BATCH_SIZE=32

# PostgreSQL Database (Opcional - si decides usar PostgreSQL)
# POSTGRES_USER=mental_health_user
# POSTGRES_PASSWORD=secure_password_here_change_me
# POSTGRES_DB=mental_health_db
